{
  "name": "augmented-tester-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Hands-on companion repo for the ebook The Augmented Tester: generative AI applied to testing, QA and code review, practised on the twodos mobile app.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "flows": "node scripts/maestro.mjs chapters/01-gen-ai-in-software-testing/03-ai-assisted-ui-flows/flows",
    "flows:capture": "node scripts/maestro.mjs chapters/01-gen-ai-in-software-testing/03-ai-assisted-ui-flows/flows/00-capture-screens.yaml",
    "flows:repeat": "node scripts/maestro.mjs --repeat 10",
    "ch1:coverage": "node chapters/01-gen-ai-in-software-testing/02-test-cases-from-a-story/coverage.mjs",
    "ch1:compare-runs": "node chapters/01-gen-ai-in-software-testing/05-non-determinism/compare-runs.mjs",
    "ch1:check-selectors": "node chapters/01-gen-ai-in-software-testing/04-hallucination-check/check-selectors.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "js-yaml": "4.1.0"
  }
}
