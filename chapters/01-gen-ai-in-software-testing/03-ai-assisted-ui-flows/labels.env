# Every UI label the flows rely on lives here, so there is ONE place to fix after a real capture.
# Maestro treats text selectors as regular expressions and matches visible text or the iOS accessibility label.
#
# STATUS: UNVERIFIED. These are starting guesses based on the wording on twodos.app.
# Capture the real screens (npm run flows:capture + exercise 04) and correct every value
# before trusting any flow result.

APP_ID=com.example.twodos            # replace: xcrun simctl listapps booted | grep -i -B2 -A2 twodos
TEST_LIST=Lab list                   # create this list once by hand in the test account

LABEL_LOGIN_EMAIL=(?i)email.*
LABEL_LOGIN_PASSWORD=(?i)password.*
LABEL_LOGIN_SUBMIT=(?i)(log ?in|sign ?in)
LABEL_ADD_TASK=(?i)(add|new) ?(task|item|to-?do)?
LABEL_TASK_INPUT=(?i).*(task|title|what).*
LABEL_SAVE_TASK=(?i)(add|save|done)
LABEL_CLEAR_DONE=(?i)clear all completed   # wording used on twodos.app
